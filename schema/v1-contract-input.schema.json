{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RoGuard v1 candidate declared-card input",
  "type": "object",
  "additionalProperties": false,
  "required": ["language"],
  "anyOf": [{"required": ["disclosure"]}, {"required": ["routing"]}, {"required": ["support"]}],
  "properties": {
    "language": {"enum": ["ro", "uk"]},
    "disclosure": {
      "type": "object", "additionalProperties": false,
      "required": ["source_role", "safety_or_support_anchor", "indirect_or_repeated_support_pattern", "explicit_support_request", "direct_safety_statement"],
      "properties": {
        "source_role": {"enum": ["minor", "adult", "other", null]},
        "safety_or_support_anchor": {"type": ["boolean", "null"]},
        "indirect_or_repeated_support_pattern": {"type": ["boolean", "null"]},
        "explicit_support_request": {"type": ["boolean", "null"]},
        "direct_safety_statement": {"type": ["boolean", "null"]},
        "retracted_or_denied": {"type": ["boolean", "null"]}
      }
    },
    "routing": {
      "type": "object", "additionalProperties": false,
      "required": ["principal", "item", "purpose", "proposed_recipient", "recipient_roles", "allowed_by_scope", "recipient_may_be_source_of_concern"],
      "properties": {
        "principal": {"type": ["string", "null"]},
        "item": {"type": ["string", "null"]},
        "purpose": {"type": ["string", "null"]},
        "proposed_recipient": {"type": ["string", "null"]},
        "recipient_roles": {"type": ["array", "null"], "items": {"type": "string"}, "uniqueItems": true},
        "allowed_by_scope": {"type": ["array", "null"], "items": {"$ref": "#/$defs/scope"}},
        "recipient_may_be_source_of_concern": {"enum": ["yes", "no", "unknown"]}
      }
    },
    "support": {
      "type": "object", "additionalProperties": false,
      "required": ["applicable_fields", "passed_fields"],
      "properties": {
        "applicable_fields": {"type": ["array", "null"], "items": {"$ref": "#/$defs/supportField"}, "uniqueItems": true},
        "passed_fields": {"type": ["array", "null"], "items": {"$ref": "#/$defs/supportField"}, "uniqueItems": true}
      }
    }
  },
  "$defs": {
    "scope": {
      "type": "object", "additionalProperties": false,
      "required": ["principal", "item", "purpose", "recipients"],
      "properties": {
        "principal": {"type": "string", "minLength": 1},
        "item": {"type": "string", "minLength": 1},
        "purpose": {"type": "string", "minLength": 1},
        "recipients": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    },
    "supportField": {"enum": ["acknowledgement", "next_step", "human_support", "no_blame", "no_secret_promise", "no_leading_question", "no_unsupported_guarantee", "no_dependency_pressure", "immediate_danger_route", "no_pressing_for_details"]}
  }
}
