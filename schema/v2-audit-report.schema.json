{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RoGuard v2 exact symbolic decision audit report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "language", "method", "categories", "caller_facts_unverified", "external_action_taken"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "language": {"enum": ["ro", "uk"]},
    "method": {"const": "exact_symbolic_completion_and_minimax_question_ranking"},
    "categories": {
      "type": "array", "minItems": 1, "maxItems": 3,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["category", "current_decision_code", "possible_decision_codes", "completion_count", "unknown_paths", "decision_stability", "witnesses", "next_questions"],
        "properties": {
          "category": {"enum": ["D1", "R1", "S1"]},
          "current_decision_code": {"type": ["string", "null"]},
          "possible_decision_codes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "completion_count": {"type": ["integer", "null"], "minimum": 1},
          "unknown_paths": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "decision_stability": {"enum": ["stable", "sensitive", "unbounded"]},
          "witnesses": {"type": "array", "items": {
            "type": "object", "additionalProperties": false,
            "required": ["decision_code", "unknown_facts"],
            "properties": {
              "decision_code": {"type": "string"},
              "unknown_facts": {"type": "array", "items": {
                "type": "object", "additionalProperties": false,
                "required": ["path", "state_code"],
                "properties": {"path": {"type": "string"}, "state_code": {"type": "string"}}
              }}
            }
          }},
          "next_questions": {"type": "array", "items": {
            "type": "object", "additionalProperties": false,
            "required": ["path", "answer_codes", "branches", "worst_case_decision_count", "total_branch_decision_count", "worst_case_completion_count"],
            "properties": {
              "path": {"type": "string"},
              "answer_codes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
              "branches": {"type": "array", "items": {
                "type": "object", "additionalProperties": false,
                "required": ["answer_code", "possible_decision_codes", "completion_count"],
                "properties": {
                  "answer_code": {"type": "string"},
                  "possible_decision_codes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
                  "completion_count": {"type": "integer", "minimum": 1}
                }
              }},
              "worst_case_decision_count": {"type": "integer", "minimum": 1},
              "total_branch_decision_count": {"type": "integer", "minimum": 1},
              "worst_case_completion_count": {"type": "integer", "minimum": 1}
            }
          }}
        }
      }
    },
    "caller_facts_unverified": {"const": true},
    "external_action_taken": {"const": false}
  }
}
